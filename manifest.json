{
  "manifest_version": 3,
  "name": "PSA Sync",
  "version": "1.1.0",
  "description": "Collects world rankings and entry lists from SecurePSA and sends them to the PSA Ranking Planner.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://secure.psasquashtour.com/*",
    "https://psa-ranking-planner.vercel.app/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "PSA Sync" },
  "icons": { "128": "icon128.png" }
}
